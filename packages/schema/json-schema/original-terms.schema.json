{
  "title": "PLM original-terms file",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 5
    },
    "document": {
      "type": "string",
      "pattern": "^document:[a-z0-9-]+:\\d{4}:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage": {
            "type": "string",
            "pattern": "^p\\d{5}$"
          },
          "term": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "match": {
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "passage",
          "term",
          "match",
          "occurrence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "document",
    "annotations"
  ],
  "additionalProperties": false
}
