{
  "title": "PLM source file",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 2
    },
    "document": {
      "type": "string",
      "pattern": "^document:[a-z0-9-]+:\\d{4}:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "via": {
          "type": "string",
          "format": "uri"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parser": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "url",
        "retrieved_at",
        "snapshot",
        "snapshot_hash",
        "parser"
      ],
      "additionalProperties": false
    },
    "passages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p\\d{5}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "heading",
              "paragraph",
              "blockquote",
              "list_item",
              "footnote",
              "table",
              "caption",
              "separator"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "tombstoned"
            ]
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^p\\d{5}$"
            }
          }
        },
        "required": [
          "id",
          "type",
          "text",
          "hash",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "document",
    "title",
    "source",
    "passages"
  ],
  "additionalProperties": false
}
