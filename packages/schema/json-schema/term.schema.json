{
  "title": "PLM term file",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "term": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "original": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition": {
      "type": "object",
      "properties": {
        "short": {
          "type": "string",
          "minLength": 1
        },
        "long": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "type": "string",
                "minLength": 1
              },
              "publication": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "accessed_at": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "short"
      ],
      "additionalProperties": false
    },
    "renderings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]+$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "forms",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "default": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "scoped_defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^work:[a-z0-9-]+:\\d{4}:[a-z0-9-]+$"
              },
              {
                "type": "string",
                "pattern": "^author:[a-z0-9-]+$"
              }
            ]
          },
          "rendering": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "scope",
          "rendering"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "term",
    "original",
    "definition",
    "renderings",
    "default"
  ],
  "additionalProperties": false
}
